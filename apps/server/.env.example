# Crux Server Environment Variables
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crux_db
REDIS_URL=redis://localhost:6379

# Authentication & Security
JWT_SECRET=crux_dev_jwt_secret_32_characters_minimum_len_secure!
JWT_EXPIRES_IN=86400
COOKIE_SECRET=crux_cookie_secret_key_123456789_dev!
CORS_ORIGIN=*

# GitHub OAuth Integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Webhook Verification Secrets (Dual key rotation support)
PRIMARY_WEBHOOK_SECRET=whsec_primary_dev_secret_key_123456789
FALLBACK_WEBHOOK_SECRET=whsec_fallback_dev_secret_key_987654321

# S3 / MinIO Diff Storage (Optional for external diff ASTs)
S3_BUCKET=crux-diff-storage
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
